# Application
APP_NAME=Document Extraction API
APP_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# Microsoft SQL Server. Install Microsoft ODBC Driver 18 on the API server.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=document_annotation
DB_USER=sa
DB_PASSWORD=change-this-password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=false

# Keep false in production and run `python -m tools.init_annotation_db` explicitly.
AUTO_CREATE_DB=false

# Storage must be relative to the project root.
ANNOTATION_STORAGE_DIR=data/annotation_storage
BULK_IMPORT_ROOT=data/bulk_import_inbox

# Comma-separated frontend origins.
CORS_ORIGINS=*

# Model runtime: mock | onnx | paddle | tensorrt
MODEL_BACKEND=mock

# Device: cpu | cuda | auto
DEVICE=cpu
GPU_DEVICE_ID=0
ALLOW_CPU_FALLBACK=true

# Component switches
ENABLE_PAGE_CLASSIFIER=true
ENABLE_OCR=true
ENABLE_NOTE_EXTRACTOR=true
ENABLE_TABLE_STRUCTURE=true

# Model locations. Mount this directory on the inference server.
PAGE_CLASSIFIER_MODEL_PATH=/models/page_classifier/model.onnx
PAGE_CLASSIFIER_LABELS_PATH=/models/page_classifier/labels.json
OCR_DET_MODEL_PATH=/models/ocr/detection/model.onnx
OCR_REC_MODEL_PATH=/models/ocr/recognition/model.onnx
OCR_CHAR_DICT_PATH=/models/ocr/recognition/character_dict.txt
NOTE_EXTRACTOR_MODEL_PATH=/models/note_extractor/model.onnx
NOTE_EXTRACTOR_LABELS_PATH=/models/note_extractor/labels.json
TABLE_STRUCTURE_MODEL_PATH=/models/table_structure/model.onnx

# PDF and confidence limits
PDF_DPI=200
MAX_FILE_SIZE_MB=30
MAX_PAGES=50
MAX_RENDER_PIXELS=25000000
LOW_CONFIDENCE_THRESHOLD=0.80

# Used only by MODEL_BACKEND=mock. One label per page, in order.
MOCK_PAGE_TYPES=DIPLOMATIC_NOTE,APPLICANT_TABLE,APPLICANT_LIST,VISA_APPLICATION_FORM,TEMPORARY_RESIDENCE_EXTENSION_FORM,PASSPORT_FRONT,VISA_STICKER,VISA_REQUEST_OFFICIAL_LETTER,OTHER

# Reviewed dataset export. Relative paths are resolved from the project root.
DATASET_EXPORT_DIR=data/training/document_classifier
DATASET_COPY_MODE=copy
DATASET_SPLIT_SEED=42
DATASET_TRAIN_RATIO=0.8
DATASET_VAL_RATIO=0.1
DATASET_TEST_RATIO=0.1
DATASET_FAIL_ON_INVALID=true

# Local document classifier training.
TRAIN_OUTPUT_DIR=output/document_classifier
TRAIN_MODEL_NAME=mobilenet_v3_small
TRAIN_IMAGE_SIZE=224
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=30
TRAIN_LEARNING_RATE=0.0003
TRAIN_WEIGHT_DECAY=0.0001
TRAIN_NUM_WORKERS=4
TRAIN_DEVICE=auto
TRAIN_GPU_DEVICE_ID=0
TRAIN_MIXED_PRECISION=true
TRAIN_PRETRAINED=true
# Optional offline ImageNet state_dict. Leave unset to use torchvision's default weights.
# TRAIN_PRETRAINED_WEIGHTS_PATH=models/pretrained/mobilenet_v3_small_imagenet.pth
TRAIN_EARLY_STOPPING_PATIENCE=7
TRAIN_SEED=42
TRAIN_DETERMINISTIC=false

# Trained classifier deployment artifacts.
CLASSIFIER_ONNX_OUTPUT_PATH=models/page_classifier/model.onnx
CLASSIFIER_LABELS_OUTPUT_PATH=models/page_classifier/labels.json
CLASSIFIER_ONNX_OPSET=17

