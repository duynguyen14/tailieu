# Application
APP_NAME=Document Extraction API
APP_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# Microsoft SQL Server. Install Microsoft ODBC Driver 18 on the API server.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=document_annotation
DB_USER=sa
DB_PASSWORD=change-this-password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=false

# Keep false in production and run `python -m tools.init_annotation_db` explicitly.
AUTO_CREATE_DB=false

# Storage must be relative to the project root.
ANNOTATION_STORAGE_DIR=data/annotation_storage
BULK_IMPORT_ROOT=data/bulk_import_inbox

# Comma-separated frontend origins.
CORS_ORIGINS=*

# Model runtime: mock | onnx | paddle | tensorrt
MODEL_BACKEND=mock

# Device: cpu | cuda | auto
DEVICE=cpu
GPU_DEVICE_ID=0
ALLOW_CPU_FALLBACK=true

# Component switches
ENABLE_PAGE_CLASSIFIER=true
ENABLE_OCR=true
ENABLE_NOTE_EXTRACTOR=true
ENABLE_TABLE_STRUCTURE=true

# Model locations. Mount this directory on the inference server.
PAGE_CLASSIFIER_MODEL_PATH=models/page_classifier/model.onnx
PAGE_CLASSIFIER_LABELS_PATH=models/page_classifier/labels.json
PAGE_CLASSIFIER_MODEL_VERSION=mobilenet-v3-phase1
PAGE_CLASSIFIER_BATCH_SIZE=64
OCR_DET_MODEL_PATH=/models/ocr/detection/model.onnx
OCR_REC_MODEL_PATH=/models/ocr/recognition/model.onnx
OCR_CHAR_DICT_PATH=/models/ocr/recognition/character_dict.txt
NOTE_EXTRACTOR_MODEL_PATH=/models/note_extractor/model.onnx
NOTE_EXTRACTOR_LABELS_PATH=/models/note_extractor/labels.json
TABLE_STRUCTURE_MODEL_PATH=/models/table_structure/model.onnx

# Offline table-structure baseline and review dataset generation
TABLE_DEVICE=cpu
TABLE_GPU_DEVICE_ID=0
TABLE_ALLOW_CPU_FALLBACK=true
TABLE_LAYOUT_MODEL_NAME=PP-DocLayout-L
# Leave *_MODEL_DIR empty to let PaddleOCR download and cache official weights.
TABLE_LAYOUT_MODEL_DIR=
TABLE_STRUCTURE_MODEL_NAME=SLANet_plus
TABLE_STRUCTURE_MODEL_DIR=
TABLE_MODEL_VERSION=paddle-table-baseline-v1
TABLE_LAYOUT_THRESHOLD=0.50
TABLE_CPU_THREADS=8
TABLE_ENABLE_HPI=false
TABLE_ASSUME_FIRST_ROW_HEADER=true

# GPU-only OCR for the grounded extraction pipeline. If CUDA/Paddle GPU is
# unavailable, fail clearly instead of silently processing documents on CPU.
OCR_RUNTIME_DEVICE=cuda
OCR_RUNTIME_GPU_DEVICE_ID=0
OCR_RUNTIME_ALLOW_CPU_FALLBACK=false
OCR_DETECTION_MODEL_NAME=PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL_NAME=PP-OCRv6_medium_rec
# Leave directories empty to download official weights into the Paddle cache.
OCR_DETECTION_MODEL_DIR=
OCR_RECOGNITION_MODEL_DIR=
OCR_MODEL_VERSION=pp-ocrv6-medium-v1
OCR_ENABLE_HPI=false
OCR_CPU_THREADS=8
OCR_MIN_CONFIDENCE=0.50
OCR_TARGET_PAGE_TYPES=DIPLOMATIC_NOTE,APPLICANT_TABLE,APPLICANT_LIST
# Detect non-content regions before grounding. Tokens overlapped by at least
# OCR_AUTO_IGNORE_OVERLAP are preserved in DB but excluded from LLM input.
OCR_ENABLE_EXCLUSION_DETECTION=true
OCR_LAYOUT_MODEL_NAME=PP-DocLayout-L
OCR_LAYOUT_MODEL_DIR=
OCR_LAYOUT_THRESHOLD=0.50
OCR_EXCLUSION_REGION_TYPES=seal
OCR_AUTO_IGNORE_OVERLAP=0.70
# PaddleX 3.7 imports ModelScope (and therefore Torch) even when OCR only uses
# Paddle. BOS plus the source-check bypass prevents CUDA DLL conflicts on Windows.
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# Grounded LLM extraction / QLoRA defaults for RTX 3060 12 GB.
LLM_BASE_MODEL_ID=Qwen/Qwen3-4B
LLM_BASE_MODEL_DIR=models/llm/qwen3-4b
LLM_DEVICE=auto
LLM_GPU_DEVICE_ID=0
LLM_LOAD_IN_4BIT=true
LLM_MAX_SEQUENCE_LENGTH=4096
LLM_SCHEMA_VERSION=document-case-v1
LLM_DATASET_DIR=data/training/grounded_llm
LLM_TRAIN_BATCH_SIZE=1
LLM_GRADIENT_ACCUMULATION_STEPS=8
LLM_LORA_RANK=16
LLM_LORA_ALPHA=32
LLM_LORA_DROPOUT=0.05

# PDF and confidence limits
PDF_DPI=200
MAX_FILE_SIZE_MB=30
MAX_PAGES=50
MAX_RENDER_PIXELS=25000000
LOW_CONFIDENCE_THRESHOLD=0.80

# Used only by MODEL_BACKEND=mock. One label per page, in order.
MOCK_PAGE_TYPES=DIPLOMATIC_NOTE,APPLICANT_TABLE,APPLICANT_LIST,VISA_APPLICATION_FORM,TEMPORARY_RESIDENCE_EXTENSION_FORM,PASSPORT_FRONT,VISA_STICKER,VISA_REQUEST_OFFICIAL_LETTER,OTHER

# Reviewed dataset export. Relative paths are resolved from the project root.
DATASET_EXPORT_DIR=data/training/document_classifier
DATASET_COPY_MODE=copy
DATASET_SPLIT_SEED=42
DATASET_TRAIN_RATIO=0.8
DATASET_VAL_RATIO=0.1
DATASET_TEST_RATIO=0.1
DATASET_FAIL_ON_INVALID=true

# Local document classifier training.
TRAIN_OUTPUT_DIR=output/document_classifier
TRAIN_MODEL_NAME=mobilenet_v3_small
TRAIN_IMAGE_SIZE=224
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS=30
TRAIN_LEARNING_RATE=0.0003
TRAIN_WEIGHT_DECAY=0.0001
TRAIN_NUM_WORKERS=4
TRAIN_DEVICE=auto
TRAIN_GPU_DEVICE_ID=0
TRAIN_MIXED_PRECISION=true
TRAIN_PRETRAINED=true
# Optional offline ImageNet state_dict. Leave unset to use torchvision's default weights.
# TRAIN_PRETRAINED_WEIGHTS_PATH=models/pretrained/mobilenet_v3_small_imagenet.pth
TRAIN_EARLY_STOPPING_PATIENCE=7
TRAIN_SEED=42
TRAIN_DETERMINISTIC=false

# Trained classifier deployment artifacts.
CLASSIFIER_ONNX_OUTPUT_PATH=models/page_classifier/model.onnx
CLASSIFIER_LABELS_OUTPUT_PATH=models/page_classifier/labels.json
CLASSIFIER_ONNX_OPSET=17

